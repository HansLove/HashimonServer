{
  "name": "hashimon-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative Hashimon server — Phase 1: identity, inventory, emission. A referee, not an oracle.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && esbuild src/server.ts src/db/migrate.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/server.js",
    "migrate": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/core/core.test.ts src/domain/auth.test.ts src/domain/block-template.test.ts"
  },
  "dependencies": {
    "@noble/secp256k1": "2.2.3",
    "argon2": "0.41.1",
    "cors": "2.8.6",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "pg": "8.12.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.21",
    "@types/node": "20.19.43",
    "@types/pg": "8.11.6",
    "esbuild": "0.21.5",
    "only-allow": "1.2.1",
    "tsx": "4.16.2",
    "typescript": "7.0.2"
  }
}
