# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000

# Postgres 13+ (needs gen_random_uuid, built in). Create the db first:
#   createdb hashimon
# Postgres.app on macOS often listens on 5433, not 5432 — check with:
#   /Applications/Postgres.app/Contents/Versions/latest/bin/pg_isready -p 5433
DATABASE_URL=postgres://YOUR_USER@127.0.0.1:5433/hashimon

# How long an issued session token stays valid.
SESSION_TTL_HOURS=720

# Version tag stamped on every birth, so a creature records which ruleset made it.
ALGO_VERSION=caos-core@1

# Commit stamped on every log event, so a failure can be traced to its deploy.
# Locally it stays "dev"; in the image the Dockerfile takes it as a build arg.
COMMIT_SHA=dev

# PoW bound mode (~1M hashes/share @ 20 bits, few seconds at browser worker
# hashrate ~100-300k H/s; kept high to bound write load on POST /shares)
HASHIMON_SHARE_TARGET_BITS=20
HASHIMON_JOB_TTL_MS=900000
HASHIMON_BLOCK_TARGET_BITS=64

# Extra allowed browser origins (comma-separated). https://ihashima.com is always
# allowed in code even if this list is empty. Production must still set this on
# the droplet so a stale env file cannot shrink the allowlist accidentally.
CORS_ORIGIN=https://ihashima.com,https://www.ihashima.com,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://localhost:5173,http://localhost:3000

# Shared secret for Luanti server → API (auth poll + bind). Required in production.
LUANTI_SERVER_SECRET=change-me-in-production

# Bitcoin Core RPC URL with basic-auth embedded (user:pass@host:port). Never commit the
# real value — see src/domain/block-template.ts.
BTC_NODE_CONNECTION_URL=http://YOUR_USER:YOUR_PASSWORD@127.0.0.1:8332

# "bitcoin" requires a client that implements hashBitcoinJob (src/core/pow.ts) — flipping
# this without a matching client rejects every share. Default stays "bound".
HASHIMON_MINING_MODE=bound
HASHIMON_TEMPLATE_REFRESH_MS=30000

# Segwit address (bech32/bech32m) the coinbase output pays. Required only when
# HASHIMON_MINING_MODE=bitcoin — the app fails to start without it in that mode, no default.
HASHIMON_COINBASE_ADDRESS=bc1qcpzntzsnkkz7fue6jqumey63rj4epqj59uyws0

# BTCPay Server (credit purchases). The middleware singleton reads these names itself,
# but src/config.ts stays the single source — it passes them to configure() explicitly.
# BTCPAY_API_KEY and BTCPAY_WEBHOOK_SECRET are secrets: never log them, never commit them.
BTCPAY_BASE_URL=https://YOUR_BTCPAY_HOST
BTCPAY_API_KEY=change-me
BTCPAY_STORE_ID=change-me
BTCPAY_WEBHOOK_SECRET=change-me
